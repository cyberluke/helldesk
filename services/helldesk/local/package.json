{
  "name": "@cyberluke/local-helldesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HELLDESK Local — native Windows adversarial review engine (local orchestrator + Kilo plugin). Developed as the self-contained HELLDESK local tier with all Cloudflare/Kilo Gateway dependencies removed.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "bun run src/main.ts --dev",
    "start": "bun run src/main.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/",
    "test": "bun test tests/unit/ tests/integration/ tests/e2e/",
    "verify": "bun run .\\scripts\\verify.ps1",
    "smoke": "bun run .\\scripts\\smoke.ps1",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "@cyberluke/nai-lattice-client": "^0.2.0",
    "@kilocode/plugin": "7.4.22",
    "@kilocode/sdk": "7.4.22",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "24.12.4",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.8.2"
  }
}